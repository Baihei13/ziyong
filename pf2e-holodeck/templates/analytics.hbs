                                    </summary>
                                    
                                    <div style="padding: 15px; border-top: 1px dashed #444; background: rgba(10,10,15,0.95); display: flex; flex-direction: column; gap: 15px;">
                                        
                                        <div style="background: rgba(0,0,0,0.3); border: 1px solid #333; padding: 10px; border-radius: 4px; font-size: 0.85em;">
                                            <div style="color: #aaa; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; border-bottom: 1px dashed #444; padding-bottom: 3px;"><i class="fas fa-users"></i> {{localize "PF2E-HOLODECK.Forensics.Combatants"}} Present</div>
                                            <div style="margin-bottom: 3px;"><b style="color: #44aaff;">{{localize "PF2E-HOLODECK.Forensics.Allies"}}</b> <span style="color: #ccc;">{{otherPartyStr}}</span></div>
                                            <div><b style="color: #ff6666;">{{localize "PF2E-HOLODECK.Forensics.EnemiesLabel"}}</b> <span style="color: #ccc;">{{otherEnemiesStr}}</span></div>
                                        </div>

                                        <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-around; text-align: center; margin-bottom: 5px;">
                                            <div style="flex: 1;"><div style="font-size: 0.7em; color: #888; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.BestHit"}}</div><div style="color: #44aaff; font-weight: bold;">{{eMaxDmg}} DMG</div></div>
                                            <div style="flex: 1; border-left: 1px solid #333;"><div style="font-size: 0.7em; color: #888; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.HardestTaken"}}</div><div style="color: #ff6666; font-weight: bold;">{{eMaxTaken}} DMG</div></div>
                                            <div style="flex: 1; border-left: 1px solid #333;"><div style="font-size: 0.7em; color: #888; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.Dodge"}}</div><div style="color: #44ffaa; font-weight: bold;">{{eDodge}}%</div></div>
                                            <div style="flex: 1; border-left: 1px solid #333;"><div style="font-size: 0.7em; color: #888; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.Resist"}}</div><div style="color: #aa44ff; font-weight: bold;">{{eResist}}%</div></div>
                                        </div>

                                        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                                            {{#if targetsDamaged.length}}
                                            <div style="flex: 1; min-width: 200px; background: rgba(255,102,102,0.05); border: 1px solid #442222; border-radius: 4px; padding: 10px;">
                                                <div style="color: #ff6666; font-size: 0.8em; text-transform: uppercase; font-weight: bold; margin-bottom: 8px; border-bottom: 1px dashed #442222; padding-bottom: 4px;">{{localize "PF2E-HOLODECK.Forensics.Offense"}}</div>
                                                {{#each targetsDamaged}}
                                                    <div style="margin-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 4px;">
                                                        <div style="display: flex; justify-content: space-between; font-size: 0.9em; color: #eee; font-weight: bold; margin-bottom: 4px;">
                                                            <span>{{name}}</span><span style="color: #ff6666;">{{amount}} DMG</span>
                                                        </div>
                                                        {{#each actions}}
                                                            <div style="display: flex; justify-content: space-between; font-size: 0.8em; color: #888; padding-left: 10px;">
                                                                <span>↳ {{name}}</span><span>{{amount}}</span>
                                                            </div>
                                                        {{/each}}
                                                    </div>
                                                {{/each}}
                                            </div>
                                            {{/if}}

                                            {{#if attackers.length}}
                                            <div style="flex: 1; min-width: 200px; background: rgba(68,170,255,0.05); border: 1px solid #223344; border-radius: 4px; padding: 10px;">
                                                <div style="color: #44aaff; font-size: 0.8em; text-transform: uppercase; font-weight: bold; margin-bottom: 8px; border-bottom: 1px dashed #223344; padding-bottom: 4px;">{{localize "PF2E-HOLODECK.Forensics.Defense"}}</div>
                                                {{#each attackers}}
                                                    <div style="margin-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 4px;">
                                                        <div style="display: flex; justify-content: space-between; font-size: 0.9em; color: #eee; font-weight: bold; margin-bottom: 4px;">
                                                            <span>{{name}}</span><span style="color: #44aaff;">{{amount}} DMG</span>
                                                        </div>
                                                        {{#each actions}}
                                                            <div style="display: flex; justify-content: space-between; font-size: 0.8em; color: #888; padding-left: 10px;">
                                                                <span>↳ {{name}}</span><span>{{amount}}</span>
                                                            </div>
                                                        {{/each}}
                                                    </div>
                                                {{/each}}
                                            </div>
                                            {{/if}}
                                        </div>

                                        {{#if (or advanced.providedCover advanced.taunts advanced.huntedShots advanced.surges)}}
                                        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                            {{#if advanced.providedCover}}
                                            <div style="background: rgba(0,0,0,0.5); border: 1px solid #555; padding: 8px 12px; border-radius: 4px; flex: 1; min-width: 120px; text-align: center;">
                                                <div style="color: #888; font-size: 0.7em; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.AlwaysWayShort"}}</div>
                                                <div style="color: #ffcc00; font-weight: bold; font-size: 1.1em;">{{advanced.providedCover}} <span style="font-size: 0.6em; color: #aaa;">{{localize "PF2E-HOLODECK.Forensics.Interrupts"}}</span></div>
                                                <div style="font-size: 0.7em; color: #777;">(<span style="color:#ff6666;">{{advanced.interruptedEnemy}} E</span> / <span style="color:#44aaff;">{{advanced.interruptedFriendly}} F</span>)</div>
                                            </div>
                                            {{/if}}
                                            {{#if advanced.taunts}}
                                            <div style="background: rgba(0,0,0,0.5); border: 1px solid #555; padding: 8px 12px; border-radius: 4px; flex: 1; min-width: 120px; text-align: center;">
                                                <div style="color: #888; font-size: 0.7em; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.TauntsUsed"}}</div>
                                                <div style="color: #44aaff; font-weight: bold; font-size: 1.1em;">{{advanced.taunts}} <span style="font-size: 0.6em; color: #aaa;">({{advanced.tauntTriggers}} Trig)</span></div>
                                            </div>
                                            {{/if}}
                                            {{#if advanced.huntedShots}}
                                            <div style="background: rgba(0,0,0,0.5); border: 1px solid #555; padding: 8px 12px; border-radius: 4px; flex: 1; min-width: 120px; text-align: center;">
                                                <div style="color: #888; font-size: 0.7em; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.HuntedShots"}}</div>
                                                <div style="color: #ffaa00; font-weight: bold; font-size: 1.1em;">{{advanced.huntedShots}} <span style="font-size: 0.6em; color: #aaa;">({{advanced.huntedShotDmg}} DMG)</span></div>
                                            </div>
                                            {{/if}}
                                            {{#if advanced.surges}}
                                            <div style="background: rgba(0,0,0,0.5); border: 1px solid #555; padding: 8px 12px; border-radius: 4px; flex: 1; min-width: 120px; text-align: center;">
                                                <div style="color: #888; font-size: 0.7em; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.WellspringSurges"}}</div>
                                                <div style="color: #aa44ff; font-weight: bold; font-size: 1.1em;">{{advanced.surges}} <span style="font-size: 0.6em; color: #aaa;">({{advanced.surgeFriendlyDmg}} FF)</span></div>
                                            </div>
                                            {{/if}}
                                        </div>
                                        {{/if}}
                                    </div>
                                </details>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{/if}}
               

        {{else}}
            <div style="text-align: center; color: #888; padding: 40px; font-style: italic;">
                {{localize "PF2E-HOLODECK.Forensics.Awaiting"}}
            </div>
        {{/if}}
    </div>
</div>