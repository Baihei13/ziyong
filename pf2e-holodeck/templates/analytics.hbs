<div class="forensics-container">
    
    <div class="forensics-header">
        <div class="forensics-header-top">
            <h2 class="forensics-title"><i class="fas fa-microscope"></i> {{localize "PF2E-HOLODECK.Forensics.Title"}}</h2>
            
            <div class="forensics-controls">
                <select id="analytics-selector" class="forensics-selector">
                    <option value="current" {{#if (eq selectedEncounter 'current')}}selected{{/if}}>{{localize "PF2E-HOLODECK.Forensics.CurrentLive"}}</option>
                    <option value="exploration" style="color: #44ff44;" {{#if (eq selectedEncounter 'exploration')}}selected{{/if}}>{{localize "PF2E-HOLODECK.Forensics.LiveExplore"}}</option>
                    
                    <optgroup label="{{localize 'PF2E-HOLODECK.Forensics.OptCampaign'}}">
                        <option value="meta" style="font-weight: bold; color: #ffaa00;" {{#if (eq selectedEncounter 'meta')}}selected{{/if}}>{{localize "PF2E-HOLODECK.Forensics.MetaCombat"}}</option>
                        <option value="meta-explore" style="font-weight: bold; color: #44ff44;" {{#if (eq selectedEncounter 'meta-explore')}}selected{{/if}}>{{localize "PF2E-HOLODECK.Forensics.MetaExplore"}}</option>
                        {{#if isGM}}
                        <option value="meta-sim" style="font-weight: bold; color: #ff4444;" {{#if (eq selectedEncounter 'meta-sim')}}selected{{/if}}>{{localize "PF2E-HOLODECK.Forensics.MetaSim"}}</option>
                        {{/if}}
                    </optgroup>

                    <optgroup label="{{localize 'PF2E-HOLODECK.Forensics.OptCombat'}}">
                    {{#each historyKeys}}<option value="{{this}}" {{#if (eq ../selectedEncounter this)}}selected{{/if}}>{{this}}</option>{{/each}}
                    </optgroup>

                    <optgroup label="{{localize 'PF2E-HOLODECK.Forensics.OptExplore'}}">
                    {{#each exploreKeys}}<option value="{{this}}" {{#if (eq ../selectedEncounter this)}}selected{{/if}}>{{this}}</option>{{/each}}
                    </optgroup>

                    {{#if isGM}}
                    <optgroup label="{{localize 'PF2E-HOLODECK.Forensics.OptSim'}}">
                    {{#each simKeys}}<option value="{{this}}" {{#if (eq ../selectedEncounter this)}}selected{{/if}}>{{this}}</option>{{/each}}
                    </optgroup>
                    {{/if}}
               </select>

         {{#if isGM}}
                <button type="button" class="forensics-btn" data-action="createManualLog" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipManual'}}" style="background: #333311; border-color: #ffff44; color: #ffff44;"><i class="fas fa-plus-circle"></i></button>
                <button type="button" class="forensics-btn" data-action="deleteEncounter" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipDelete'}}" style="background: #441111; border-color: #ff4444; color: #ff6666;"><i class="fas fa-calendar-times"></i></button>
                <button type="button" class="forensics-btn" data-action="exportData" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipExport'}}" style="background: #113311; border-color: #44ff44; color: #44ff44;"><i class="fas fa-book"></i></button>
                <button type="button" class="forensics-btn" data-action="downloadJSON" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipJSON'}}" style="background: #113355; border-color: #44aaff; color: #44aaff;"><i class="fas fa-file-code"></i></button>
                <button type="button" class="forensics-btn" data-action="importData" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipImport'}}" style="background: #331133; border-color: #aa44ff; color: #aa44ff;"><i class="fas fa-file-import"></i></button>
                <button type="button" class="forensics-btn" data-action="clearHistory" data-tooltip="{{localize 'PF2E-HOLODECK.Forensics.TipPurge'}}" style="background: #441111; border-color: #ff4444; color: #ffaa00;"><i class="fas fa-trash"></i></button>
                {{/if}}
            </div>
        </div>
        
        <div class="forensics-stats">
            {{#if isGM}}
                {{localize "PF2E-HOLODECK.Forensics.ExpectedDiff"}} <span style="color: {{stats.diffColor}}; font-weight: bold;">{{stats.difficultyStr}}</span> | 
            {{/if}}
            {{localize "PF2E-HOLODECK.Forensics.ActiveCombatants"}} <span style="color: #44aaff; font-weight: bold;">{{stats.partyCount}} {{localize "PF2E-HOLODECK.Forensics.Party"}}</span> {{#if isGM}}vs <span style="color: #ff4444; font-weight: bold;">{{stats.enemyCount}} {{localize "PF2E-HOLODECK.Forensics.Enemy"}}</span>{{/if}} | 
            {{localize "PF2E-HOLODECK.Forensics.TotalActions"}} <span style="color: #fff;">{{stats.partyActions}}{{#if isGM}} vs {{stats.enemyActions}}{{/if}}</span> |
            {{localize "PF2E-HOLODECK.Forensics.ActiveTime"}} <span style="color: #ffaa00; font-weight: bold;">{{stats.totalEncounterTimeStr}}</span>
        </div>
    </div>

   <div class="forensics-nav">
        <button type="button" class="forensics-nav-btn {{#if (eq viewMode 'overview')}}active{{else}}inactive{{/if}}" data-action="setViewMode" data-mode="overview">
            <i class="fas fa-chart-pie"></i> {{localize "PF2E-HOLODECK.Forensics.Overview"}}
        </button>
        <button type="button" class="forensics-nav-btn {{#if (eq viewMode 'time')}}active{{else}}inactive{{/if}}" data-action="setViewMode" data-mode="time">
            <i class="fas fa-stream"></i> {{localize "PF2E-HOLODECK.Forensics.Timeline"}}
        </button>
        <button type="button" class="forensics-nav-btn {{#if (eq viewMode 'actor')}}active{{else}}inactive{{/if}}" data-action="setViewMode" data-mode="actor">
            <i class="fas fa-users"></i> {{localize "PF2E-HOLODECK.Forensics.Combatants"}}
        </button>
        <button type="button" class="forensics-nav-btn {{#if (eq viewMode 'dossier')}}active{{else}}inactive{{/if}}" data-action="setViewMode" data-mode="dossier">
            <i class="fas fa-id-card"></i> {{localize "PF2E-HOLODECK.Forensics.Dossier"}}
        </button>
    </div>

    <div class="forensics-content-area">
        {{#if hasData}}
            
            {{#if (eq viewMode 'overview')}}
                {{#unless isMeta}}
                <div class="forensics-graph-container">
                    <svg viewBox="0 0 750 150" style="width: 100%; height: 100%;">
                        <line x1="30" y1="20" x2="730" y2="20" stroke="#333" stroke-width="1" stroke-dasharray="4" />
                        <line x1="30" y1="75" x2="730" y2="75" stroke="#333" stroke-width="1" stroke-dasharray="4" />
                        <line x1="30" y1="130" x2="730" y2="130" stroke="#555" stroke-width="1" />
                        
                        <text x="25" y="24" fill="#888" font-size="11" text-anchor="end" font-family="sans-serif">{{graph.maxDamage}}</text>
                        <text x="25" y="79" fill="#888" font-size="11" text-anchor="end" font-family="sans-serif">{{graph.halfDamage}}</text>
                        <text x="25" y="134" fill="#888" font-size="11" text-anchor="end" font-family="sans-serif">0</text>

                        <polyline points="{{graph.partyPoints}}" fill="none" stroke="#44aaff" stroke-width="3" stroke-linejoin="round" />
                        {{#each graph.pDots}}<circle cx="{{x}}" cy="{{y}}" r="4" fill="#44aaff" />{{/each}}

                        {{#if isGM}}
                            <polyline points="{{graph.enemyPoints}}" fill="none" stroke="#ff4444" stroke-width="3" stroke-linejoin="round" />
                            {{#each graph.eDots}}<circle cx="{{x}}" cy="{{y}}" r="4" fill="#ff4444" />{{/each}}
                        {{/if}}

                        {{#each graph.xLabels}}
                        <text x="{{x}}" y="146" fill="#aaa" font-size="11" text-anchor="middle" font-family="sans-serif" font-weight="bold">R{{round}}</text>
                        {{/each}}
                    </svg>
                    <div class="forensics-graph-legend">
                        <span style="color: #44aaff; font-weight: bold; margin-right: 3px;">■</span> {{localize "PF2E-HOLODECK.Forensics.PartyDMG"}}
                        {{#if isGM}} &nbsp;&nbsp;|&nbsp;&nbsp; <span style="color: #ff4444; font-weight: bold; margin-right: 3px;">■</span> {{localize "PF2E-HOLODECK.Forensics.EnemyDMG"}} {{/if}}
                    </div>
                </div>
                {{/unless}}

                <div class="pitboss-main-wrapper">
                    <div class="pitboss-panel">
                        <div class="pitboss-header">
                            <i class="fas fa-eye"></i> {{localize "PF2E-HOLODECK.Forensics.PitBoss"}}
                        </div>
                        <div class="pitboss-grid">
                            <div class="pitboss-row main-metrics">
                                {{!-- {{localize "PF2E-HOLODECK.Forensics.Fate"}} Card --}}
                                <div class="pitboss-card insight-card fate">
                                    <div class="pitboss-card-title"><i class="fas fa-dice"></i> {{localize "PF2E-HOLODECK.Forensics.Fate"}}</div>
                                    <div class="pitboss-stat-content">
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.Luckiest"}}</span> 
                                            <span class="stat-value luckiest">{{pitBoss.luckiestName}} <span class="sub-val">({{pitBoss.luckiestAvg}})</span></span>
                                        </div>
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.Unluckiest"}}</span> 
                                            <span class="stat-value unluckiest">{{pitBoss.unluckiestName}} <span class="sub-val">({{pitBoss.unluckiestAvg}})</span></span>
                                        </div>
                                    </div>
                                </div>

                                {{!-- {{localize "PF2E-HOLODECK.Forensics.Variance"}} Card --}}
                                <div class="pitboss-card insight-card variance">
                                    <div class="pitboss-card-title"><i class="fas fa-chart-line"></i> {{localize "PF2E-HOLODECK.Forensics.Variance"}}</div>
                                    <div class="pitboss-stat-content">
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.PartyVsMean"}}</span> 
                                            <span class="stat-value skew" style="color: {{pitBoss.partySkewColor}};">{{pitBoss.partySkewStr}}</span>
                                        </div>
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.EnemyVsMean"}}</span> 
                                            <span class="stat-value skew" style="color: {{pitBoss.enemySkewColor}};">{{pitBoss.enemySkewStr}}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="pitboss-card insight-card efficiency">
                                    <div class="pitboss-card-title"><i class="fas fa-hourglass-half"></i> {{localize "PF2E-HOLODECK.Forensics.TimeEff"}}</div>
                                    <div class="pitboss-stat-content">
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.PartyPace"}}</span> 
                                            <span class="stat-value pace-party">{{pitBoss.partyPaceStr}}</span>
                                        </div>
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.EnemyPace"}}</span> 
                                            <span class="stat-value pace-enemy">{{pitBoss.enemyPaceStr}}</span>
                                        </div>
                                    </div>
                                </div>


                                {{#if (or pitBoss.synergy.guardianTaunts pitBoss.synergy.hunterShots pitBoss.synergy.surges pitBoss.synergy.wallMitigated pitBoss.synergy.dodgeKing.total pitBoss.synergy.saveKing.total)}}
                                <div class="pitboss-card insight-card synergy" style="border-color: #aa44ff !important;">
                                    <div class="pitboss-card-title"><i class="fas fa-handshake"></i> {{localize "PF2E-HOLODECK.Forensics.Utility"}}</div>
                                    <div class="pitboss-stat-content" style="max-height: 125px; overflow-y: auto; padding-right: 4px;">
                                    
                                        
                                        {{#if pitBoss.synergy.guardianTaunts}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.TopGuardian"}}</span> 
                                            <span class="stat-value" style="color: #44aaff;">{{pitBoss.synergy.guardianName}} 
                                                <span class="sub-val">({{pitBoss.synergy.guardianTaunts}} Taunts)</span>
                                            </span>
                                        </div>
                                        {{/if}}

                                        {{#if pitBoss.synergy.wallMitigated}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.IronWall"}}</span> 
                                            <span class="stat-value" style="color: #44ff44;">{{pitBoss.synergy.wallName}} 
                                                <span class="sub-val">({{pitBoss.synergy.wallMitigated}} BLKD)</span>
                                            </span>
                                        </div>
                                        {{/if}}
                                        {{#if pitBoss.synergy.meatShield.name}}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; font-size: 0.85rem;">
            <span style="color: #ccc; font-weight: bold; text-transform: uppercase;">{{localize "PF2E-HOLODECK.Forensics.AlwaysWay"}}</span>
            <div style="text-align: right;">
                <span style="color: #ffcc00; font-weight: bold;">{{pitBoss.synergy.meatShield.name}}</span>
                <span style="color: #aaa; margin-left: 4px;">({{pitBoss.synergy.meatShield.coverProvided}} Interrupts)</span>
            </div>
        </div>
        {{/if}}
                                        {{#if pitBoss.synergy.dodgeKing.total}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.HardestHit"}}</span> 
                                            <span class="stat-value" style="color: #44ffaa;">{{pitBoss.synergy.dodgeKing.name}} 
                                                <span class="sub-val">({{pitBoss.synergy.dodgeKing.pct}}% Dodge)</span>
                                            </span>
                                        </div>
                                        {{/if}}

                                        {{#if pitBoss.synergy.saveKing.total}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.MostEvasive"}}</span> 
                                            <span class="stat-value" style="color: #aa44ff;">{{pitBoss.synergy.saveKing.name}} 
                                                <span class="sub-val">({{pitBoss.synergy.saveKing.pct}}% Resist)</span>
                                            </span>
                                        </div>
                                        {{/if}}

                                        {{#if pitBoss.synergy.hunterShots}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.ApexHunter"}}</span> 
                                            <span class="stat-value" style="color: #ffaa00;">{{pitBoss.synergy.hunterName}} 
                                                <span class="sub-val">({{pitBoss.synergy.hunterDmg}} {{localize "PF2E-HOLODECK.Forensics.FusedDMG"}})</span>
                                            </span>
                                        </div>
                                        {{/if}}

                                        {{#if pitBoss.synergy.surges}}
                                        <div class="pitboss-stat-row">
                                            <span class="stat-label">{{localize "PF2E-HOLODECK.Forensics.Wellspring"}}</span> 
                                            <span class="stat-value" style="color: #aa44ff;">{{pitBoss.synergy.surgerName}} 
                                                <span class="sub-val">({{pitBoss.synergy.surges}} Surges)</span>
                                            </span>
                                        </div>
                                        {{/if}}

                                    </div>
                                </div>
                                {{/if}}
                            </div>

                            <div class="pitboss-row charts-row">
                                {{!-- {{localize "PF2E-HOLODECK.Forensics.EnemyElements"}} --}}
                                <div class="pitboss-card chart-card">
                                    <div class="pitboss-card-title">{{localize "PF2E-HOLODECK.Forensics.EnemyElements"}}</div>
                                    <div class="chart-container">
                                        {{#if pitBoss.pieSlices.length}}
                                            <svg viewBox="0 0 100 100" class="pitboss-pie" style="overflow: visible !important;">
                                                {{#each pitBoss.pieSlices}}
                                                    <path d="{{path}}" fill="{{color}}" stroke="#111" stroke-width="0.5" data-tooltip="{{tooltip}}"></path>
                                                {{/each}}
                                            </svg>
                                            <div class="chart-legend">
                                                {{#each pitBoss.legendItems}}
                                                    <span data-tooltip="{{tooltip}}"><i class="fas fa-square" style="color: {{color}};"></i> {{name}}</span>
                                                {{/each}}
                                            </div>
                                        {{else}}
                                            <div class="no-data-msg">{{localize "PF2E-HOLODECK.Forensics.NoElement"}}</div>
                                        {{/if}}
                                    </div>
                                </div>

                                {{!-- {{localize "PF2E-HOLODECK.Forensics.TimeDist"}} --}}
                                <div class="pitboss-card chart-card">
                                    <div class="pitboss-card-title">{{localize "PF2E-HOLODECK.Forensics.TimeDist"}}</div>
                                    <div class="chart-container">
                                        {{#if pitBoss.timePieSlices.length}}
                                            <svg viewBox="0 0 100 100" class="pitboss-pie" style="overflow: visible !important;">
                                                {{#each pitBoss.timePieSlices}}
                                                    <path d="{{path}}" fill="{{color}}" stroke="#111" stroke-width="0.5" data-tooltip="{{tooltip}}"></path>
                                                {{/each}}
                                            </svg>
                                            <div class="chart-legend">
                                                {{#each pitBoss.timeLegendItems}}
                                                    <span data-tooltip="{{tooltip}}"><i class="fas fa-square" style="color: {{color}};"></i> {{name}} ({{formattedTime}})</span>
                                                {{/each}}
                                            </div>
                                        {{else}}
                                            <div class="no-data-msg">{{localize "PF2E-HOLODECK.Forensics.NoTurn"}}</div>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/if}}

            {{#if (or (eq viewMode 'overview') (eq viewMode 'actor'))}}
                {{#if pcs.length}}
                <div class="actor-faction-header actor-faction-party">
                    <i class="fas fa-users" style="color: #44aaff; margin-right: 5px;"></i> {{localize "PF2E-HOLODECK.Forensics.PartyAllies"}}
                </div>
                {{#each pcs}}
                <details class="forensics-actor-overview" data-actor="{{name}}" {{#if (lookup ../expandedActors name)}}open{{/if}}>
                    <summary style="padding: 10px; outline: none; cursor: pointer;">
                        <div class="actor-summary-header">
                            <span class="actor-name-row"><i class="fas fa-caret-right disclosure-arrow"></i>{{name}}</span>
                            <span class="actor-metrics-row">
                                {{#if ../canAudit}}
                                <a data-action="swapAllegiance" data-actor="{{name}}" style="margin-right: 15px; color: #aaa; cursor: pointer; font-size: 0.9em;"><i class="fas fa-exchange-alt"></i></a>
                                {{/if}}
                               {{#if ../isExploration}}
                                    <span style="color: #fff;">{{totalChecks}} Checks</span> 
                                {{else}}
                                    <span style="color: #aaa; font-size: 0.85em; margin-right: 12px; font-weight: normal;" title="Average Turn Length / Max Turn Length"><i class="far fa-clock"></i> {{avgTurnTimeStr}} <span style="color: #666;">/</span> {{maxTurnTimeStr}}</span>
                                    <span style="color: #fff;">{{damageDealt}} DMG</span> <span style="color: #888; font-size: 0.8em;">({{dpr}} DPR)</span> <span style="color: {{this.dprDeltaColor}}">
    {{this.dprDeltaStr}} vs Past Mean ({{this.historicalDpr}} avg)
</span>
                                    <span style="color: #ffaa00; margin-left: 5px; font-size: 0.9em;">[{{kills}}K / {{assists}}A]</span>
                                    {{#if healingDealt}}<span style="color: #44ff44; margin-left: 5px;">| {{healingDealt}} HEAL</span>{{/if}}
                                {{/if}}
                            </span>
                        </div>

                        <div class="actor-health-bar-container large-bar">
                            {{#if ../isExploration}}
                                <div style="width: {{successRate}}%; background: linear-gradient(90deg, var(--forensics-explore-grad) 0%, var(--forensics-explore-main) 100%); height: 100%;">
                                    <span class="bar-label">{{successRate}}%</span>
                                </div>
                            {{else}}
                                <div style="width: {{damagePercent}}%; background: linear-gradient(90deg, var(--forensics-party-grad) 0%, var(--forensics-party-main) 100%); height: 100%;">
                                    <span class="bar-label">{{damagePercent}}%</span>
                                </div>
                            {{/if}}
                        </div>
                    </summary>
                    
                    <div style="background: rgba(15, 15, 20, 0.95); padding: 10px; border-top: 1px solid #444;">
                        
                        {{!-- TOP STAT ROW W/ SYNERGY INJECTION --}}
                        <div style="display: flex; flex-wrap: wrap; justify-content: space-around; gap: 10px; text-align: center; margin-bottom: 15px; border-bottom: 1px dashed #333; padding-bottom: 15px;">
                            <div>
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.AvgD20"}}</div>
                                <div style="color: #ffcc00; font-weight: bold; font-size: 1.2em;">{{avgD20Display}}</div>
                            </div>
                            <div style="border-left: 1px solid #333; padding-left: 15px;">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.BestAction"}}</div>
                                <div style="color: #44aaff; font-weight: bold; font-size: 1.2em;">{{maxDamageDealt}} DMG</div>
                            </div>
                            <div style="border-left: 1px solid #333; padding-left: 15px;">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.HardestTaken"}}</div>
                                <div style="color: #ff6666; font-weight: bold; font-size: 1.2em;">{{maxDamageTaken}} DMG</div>
                            </div>
                            {{#if maxHealDealt}}
                            <div style="border-left: 1px solid #333; padding-left: 15px;">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.BiggestHeal"}}</div>
                                <div style="color: #44ff44; font-weight: bold; font-size: 1.2em;">{{maxHealDealt}} HP</div>
                            </div>
                            {{/if}}
                            {{#if mitigated}}
                            <div style="border-left: 1px solid #333; padding-left: 15px;">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.TotalBlocked"}}</div>
                                <div style="color: #44aaff; font-weight: bold; font-size: 1.2em;">{{mitigated}} BLKD</div>
                            </div>
                            {{/if}}
                            
                            <div style="border-left: 1px solid #333; padding-left: 15px;" data-tooltip="{{dodgeTooltip}}">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.DodgeChance"}}</div>
                                <div style="color: #44ffaa; font-weight: bold; font-size: 1.2em;">{{dodgeChance}}%</div>
                            </div>
                            <div style="border-left: 1px solid #333; padding-left: 15px;" data-tooltip="{{saveTooltip}}">
                                <div style="font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{localize "PF2E-HOLODECK.Forensics.ResistChance"}}</div>
                                <div style="color: #aa44ff; font-weight: bold; font-size: 1.2em;">{{saveChance}}%</div>
                            </div>
<div class="metric-group">
    <div class="metric-label">{{localize "PF2E-HOLODECK.Forensics.ShotsInterrupted"}}</div>
    <div class="metric-value">
