<div class="holodeck-container">
    <div class="header-control">
        <button class="{{#if isSimActive}}active-sim{{/if}}" data-action="toggleSim">
            {{#if isSimActive}}{{localize "PF2E-HOLODECK.HUD.Deactivate"}}{{else}}{{localize "PF2E-HOLODECK.HUD.InitSim"}}{{/if}}
        </button>
    </div>

    <hr>

    <div class="state-controls flexcol">
        <div class="flexrow">
            <input type="text" id="new-state-name" placeholder="{{localize "PF2E-HOLODECK.HUD.NewStatePlaceholder"}}" />
            <button data-action="createState"><i class="fas fa-plus"></i></button>
        </div>

        <div class="flexrow">
            <select id="state-selector">
                {{#each states as |state name|}}
                    <option value="{{name}}">{{name}}</option>
                {{/each}}
            </select>
        </div>

        <div class="flexrow execution-row">
            <button data-action="saveState" title="{{localize "PF2E-HOLODECK.HUD.OverwriteSelected"}}"><i class="fas fa-save"></i> {{localize "PF2E-HOLODECK.HUD.Save"}}</button>
            <button data-action="loadState" title="{{localize "PF2E-HOLODECK.HUD.LoadSelected"}}"><i class="fas fa-upload"></i> {{localize "PF2E-HOLODECK.HUD.Load"}}</button>
            <button data-action="deleteState" title="{{localize "PF2E-HOLODECK.HUD.DeleteSelected"}}"><i class="fas fa-trash"></i></button>
        </div>
    </div>

    <hr>

    <div class="footer-control">
        <button data-action="commitChanges" title="{{localize "PF2E-HOLODECK.HUD.CommitNPCHint"}}">
            <i class="fas fa-code-branch"></i> {{localize "PF2E-HOLODECK.HUD.CommitNPC"}}
        </button>
    </div>
</div>
